# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real secrets.

# Only needed if you want Postgres locally instead of the default SQLite
# file (ecr_viewer.db). Leave unset to use SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname

# Signs the admin login session cookie - any long random string.
SECRET_KEY=change-me-to-a-long-random-string

# Admin login for /admin/upload.
ADMIN_USERNAME=change-me
# Generate with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
ADMIN_PASSWORD_HASH=change-me
